   "start": 396.98,
   "end": 418.1,
   "duration": 21.12,
   "beats": [
    {
     "start": 396.98,
     "end": 399.0,
     "text": "There is a twist to that story."
    },
    {
     "start": 399.0,
     "end": 403.86,
     "text": "A 2020 paper pointed out that the rule banning the input words shapes the answer."
    },
