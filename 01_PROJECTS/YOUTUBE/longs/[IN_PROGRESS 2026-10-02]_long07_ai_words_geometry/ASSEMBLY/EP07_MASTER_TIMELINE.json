   "end": 396.98,
   "duration": 16.9,
   "beats": [
    {
     "start": 380.08,
     "end": 382.46,
     "text": "Their fix was geometric too."
    },
    {
     "start": 382.46,
     "end": 384.88,
     "text": "Find the direction that encodes gender,"
    },
    {
     "start": 384.88,
